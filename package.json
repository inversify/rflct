{
  "name": "rflct",
  "version": "0.0.1-alpha.2",
  "description": "RFLCT — ahead-of-time reflect metadata for TypeScript 7. Injects design:symbols and design:paramtypes at build time via unplugin or the TS7 API.",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.ts",
  "exports": {
    ".": {
      "types": "./types/index.ts",
      "default": "./runtime/index.js"
    },
    "./unplugin": "./dist/unplugin.js",
    "./vite": "./dist/unplugin.js",
    "./rollup": "./dist/unplugin.js",
    "./webpack": "./dist/unplugin.js",
    "./esbuild": "./dist/unplugin.js",
    "./transform": "./dist/core/transform.js"
  },
  "bin": {
    "rflct": "./dist/cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "types"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test \"tests/*.test.ts\"",
    "baseline-accept": "ACCEPT_BASELINES=1 node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "oxc-parser": "^0.147.0",
    "reflect-metadata": "^0.2.2",
    "unplugin": "^3.3.0"
  },
  "peerDependencies": {
    "typescript": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
